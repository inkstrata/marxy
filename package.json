{
  "name": "marxy",
  "private": true,
  "version": "0.0.0",
  "description": "A markdown reader. Free, open, quiet, and set like a book.",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && node --test orchestration/*.test.mjs",
    "lint": "node scripts/gate-font-attrs.mjs && pnpm -r lint",
    "gate:font-attrs": "node scripts/gate-font-attrs.mjs",
    "typecheck": "pnpm -r typecheck",
    "gate:licences": "node scripts/gate-licences.mjs",
    "gate:fidelity": "pnpm --filter @marxy/core test:fidelity",
    "gate:no-network": "node scripts/gate-no-network.mjs",
    "gate:golden": "pnpm --filter @marxy/core test:golden",
    "gate:aesthetics": "node scripts/gate-aesthetics.mjs",
    "gate:perf": "node scripts/gate-perf.mjs",
    "gate:bundle": "node scripts/gate-bundle.mjs",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:story": "node scripts/check-story.mjs",
    "check:pr": "node scripts/check-pr.mjs",
    "lint:theme": "pnpm --filter @marxy/theme lint",
    "lint:rust": "cd apps/desktop/src-tauri && cargo fmt --check && cargo clippy --quiet -- -D warnings",
    "precheck": "node scripts/precheck.mjs",
    "done": "node scripts/done.mjs",
    "new": "node scripts/new.mjs"
  },
  "devDependencies": {
    "dompurify": "^3.4.15",
    "markdown-it": "^15.0.2",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0"
  }
}
