{
  "name": "marxy",
  "private": true,
  "version": "0.0.0",
  "description": "A desktop reader for Markdown, code, data and other local files.",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --no-sort test && node --test scripts/lib/*.test.mjs scripts/*.test.mjs",
    "lint": "biome check . && pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "gate:licences": "node scripts/gate-licences.mjs",
    "gate:fidelity": "pnpm --filter @marxy/core test:fidelity",
    "gate:no-network": "node scripts/gate-no-network.mjs",
    "gate:golden": "pnpm --filter @marxy/core test:golden",
    "gate:aesthetics": "node scripts/gate-aesthetics.mjs",
    "perf": "node scripts/perf-harness.mjs",
    "perf:interactions": "node scripts/measure-interactions.mjs",
    "gate:bundle": "node scripts/gate-bundle.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/verify.mjs",
    "work": "node scripts/work.mjs",
    "lint:theme": "pnpm --filter @marxy/theme lint",
    "lint:rust": "cd apps/desktop/src-tauri && cargo fmt --check && cargo clippy --locked --quiet -- -D warnings"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "playwright": "1.63.0",
    "typescript": "^5.9.3"
  }
}
