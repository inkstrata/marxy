!macro MARXY_OFFER EXT
  WriteRegNone HKCU "Software\Classes\.${EXT}\OpenWithProgids" "${MARXY_PROGID}"
  WriteRegStr HKCU "Software\Classes\${MARXY_APP}\SupportedTypes" ".${EXT}" ""
!macroend

; Takes back only the value written above; a key goes too when nothing else is in it.
!macro MARXY_WITHDRAW EXT
  DeleteRegValue HKCU "Software\Classes\.${EXT}\OpenWithProgids" "${MARXY_PROGID}"
  EnumRegValue $R8 HKCU "Software\Classes\.${EXT}\OpenWithProgids" 0
  EnumRegKey $R9 HKCU "Software\Classes\.${EXT}\OpenWithProgids" 0
  ${If} $R8 == ""
  ${AndIf} $R9 == ""
    DeleteRegKey HKCU "Software\Classes\.${EXT}\OpenWithProgids"
  ${EndIf}
  EnumRegValue $R8 HKCU "Software\Classes\.${EXT}" 0
  EnumRegKey $R9 HKCU "Software\Classes\.${EXT}" 0
  ${If} $R8 == ""
  ${AndIf} $R9 == ""
    DeleteRegKey HKCU "Software\Classes\.${EXT}"
  ${EndIf}
!macroend

!macro NSIS_HOOK_POSTINSTALL
  WriteRegStr HKCU "Software\Classes\${MARXY_PROGID}" "" "Marxy document"
  WriteRegStr HKCU "Software\Classes\${MARXY_PROGID}\shell\open\command" "" "$\"$INSTDIR\${MAINBINARYNAME}.exe$\" $\"%1$\""
  WriteRegStr HKCU "Software\Classes\${MARXY_APP}" "FriendlyAppName" "${PRODUCTNAME}"
  WriteRegStr HKCU "Software\Classes\${MARXY_APP}\shell\open\command" "" "$\"$INSTDIR\${MAINBINARYNAME}.exe$\" $\"%1$\""
  !insertmacro MARXY_EXTENSIONS MARXY_OFFER
  !insertmacro UPDATEFILEASSOC
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  !insertmacro MARXY_EXTENSIONS MARXY_WITHDRAW
  DeleteRegKey HKCU "Software\Classes\${MARXY_PROGID}"
  DeleteRegKey HKCU "Software\Classes\${MARXY_APP}"
  !insertmacro UPDATEFILEASSOC
!macroend
