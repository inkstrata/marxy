{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marxy",
  "version": "0.0.1",
  "identifier": "dev.marxy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Marxy",
        "width": 960,
        "height": 760,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#151412"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "A markdown reader",
    "longDescription": "A very fast document opener that sets text like a book. No telemetry. Never touches a byte you did not ask to change.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
