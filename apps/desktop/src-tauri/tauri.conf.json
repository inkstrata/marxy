{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marxy",
  "version": "0.2.0",
  "identifier": "dev.marxy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Marxy",
        "width": 960,
        "height": 760,
        "minWidth": 564,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: marxy-file: http://marxy-file.localhost marxy-remote: http://marxy-remote.localhost; font-src 'self' marxy-file: http://marxy-file.localhost; media-src blob: marxy-file: http://marxy-file.localhost; connect-src ipc: http://ipc.localhost marxy-file: http://marxy-file.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "appimage",
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "name": "Markdown",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Default",
        "exportedType": {
          "identifier": "net.daringfireball.markdown",
          "conformsTo": ["public.plain-text"]
        }
      },
      {
        "name": "Logs, data and mail",
        "contentTypes": ["public.log", "public.yaml", "public.patch-file", "com.apple.mail.email"],
        "ext": ["log", "jsonl", "ndjson", "diff", "patch", "ipynb", "eml", "yaml", "yml", "toml"],
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "name": "Source and text",
        "contentTypes": [
          "public.text",
          "public.source-code",
          "public.script",
          "public.json",
          "public.xml"
        ],
        "ext": ["txt", "text", "ts", "tsx", "js", "jsx", "mjs", "cjs", "mts", "cts", "rs", "py", "go", "java", "kt", "kts", "c", "h", "cc", "cpp", "cxx", "hpp", "hh", "rb", "php", "swift", "sh", "bash", "zsh", "json", "html", "htm", "xml", "sql", "graphql", "lua", "r", "ex", "exs", "hs", "vue", "svelte", "css", "scss", "out", "term", "session", "csv", "tsv", "atom", "rss"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "PDF document",
        "contentTypes": ["com.adobe.pdf"],
        "ext": ["pdf"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Image",
        "contentTypes": ["public.png", "public.jpeg", "com.compuserve.gif", "org.webmproject.webp", "public.heic", "public.tiff", "com.microsoft.bmp", "public.svg-image"],
        "ext": ["png", "jpg", "jpeg", "gif", "webp", "heic", "tif", "tiff", "bmp", "svg"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Archive",
        "ext": ["zip", "tar", "tgz", "gz", "tbz", "tbz2", "bz2", "txz", "xz", "7z", "zst", "tzst", "rar", "whl", "nupkg"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Office document",
        "ext": ["docx", "pptx", "odt", "odp", "doc", "ppt", "xlsx", "xlsm", "xls", "ods"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Audio and video",
        "ext": ["mp3", "wav", "ogg", "oga", "flac", "m4a", "aac", "opus", "aiff", "aif", "mp4", "m4v", "mov", "mkv", "webm", "ogv", "avi", "mpg", "mpeg"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Font",
        "ext": ["ttf", "otf", "woff", "woff2", "ttc", "otc"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Book",
        "ext": ["epub"],
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "shortDescription": "A markdown reader",
    "longDescription": "A very fast document opener that sets text like a book. No telemetry. Never touches a byte you did not ask to change.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
