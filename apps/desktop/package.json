{
  "name": "@marxy/desktop",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The desktop shell (Tauri) and app UI.",
  "scripts": {
    "dev": "tauri dev",
    "build": "vite build && tauri build --no-bundle && node scripts/smoke-cli-open.mjs",
    "bundle": "vite build && tauri build",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check --formatter-enabled=false .",
    "test": "node --test 'test/**/*.test.mjs' 'scripts/**/*.test.mjs'",
    "verify:cli": "MARXY_SMOKE_REQUIRED=1 node scripts/smoke-cli-open.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@marxy/core": "workspace:*",
    "@marxy/shell-api": "workspace:*",
    "@marxy/theme": "workspace:*",
    "@marxy/typeset": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "katex": "^0.18.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/katex": "^0.16.8",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
