{
  "name": "@marxy/desktop",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The desktop shell (Tauri) and app UI.",
  "scripts": {
    "dev": "tauri dev",
    "build": "vite build && tauri build --no-bundle -- --locked && node scripts/smoke-cli-open.mjs",
    "bundle": "vite build && tauri build -- --locked",
    "build:web": "vite build",
    "build:harness": "vite build --outDir harness/dist",
    "build:demo": "vite build --mode demo --outDir demo-dist",
    "preview:demo": "vite preview --mode demo --outDir demo-dist --port 4173 --strictPort",
    "tour:demo": "node scripts/demo-tour.mjs",
    "check:tauri": "node scripts/tauri-check.mjs",
    "shots": "node scripts/shots.mjs",
    "sign:self-cert": "node scripts/self-signed-cert.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check --formatter-enabled=false .",
    "test": "node --test --test-concurrency=1 --experimental-strip-types \"src/**/*.test.ts\" \"src/source/*.test.mjs\" \"src/startup/*.test.mjs\" \"src/theme/*.test.mjs\" \"src/workspace/*.test.mjs\" \"test/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "test:mutations": "node scripts/mutations.mjs",
    "verify:cli": "MARXY_SMOKE_REQUIRED=1 node scripts/smoke-cli-open.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@marxy/core": "workspace:*",
    "@marxy/shell-api": "workspace:*",
    "@marxy/theme": "workspace:*",
    "@marxy/typeset": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "katex": "^0.18.7",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/katex": "^0.16.8",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
