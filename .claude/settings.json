{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/check-scale.mjs\" ] && node \"$CLAUDE_PROJECT_DIR/scripts/check-scale.mjs\" --hook || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
