{
  "_note": "Which gates a change must run, by path prefix. precheck.mjs unions the entries for every changed file. 'always' runs for any change.",
  "always": ["check", "check:story"],
  "packages/core": ["gate:golden", "gate:fidelity", "gate:no-network"],
  "packages/theme": ["gate:aesthetics", "lint:theme"],
  "packages/typeset": ["gate:aesthetics"],
  "apps/desktop": ["gate:no-network", "gate:bundle"],
  "apps/desktop/src-tauri": ["lint:rust"],
  "fixtures/corpus": ["gate:golden", "gate:fidelity", "gate:no-network"],
  "scripts/gate-fidelity.mjs": ["gate:fidelity"],
  "scripts/allowlists": ["gate:licences"],
  "package.json": ["gate:licences"],
  "pnpm-lock.yaml": ["gate:licences"],
  "apps/desktop/src-tauri/Cargo.toml": ["gate:licences"],
  "apps/desktop/src-tauri/Cargo.lock": ["gate:licences"]
}
