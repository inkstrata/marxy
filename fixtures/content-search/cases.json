    "hits": [
     {
      "path": "/r/a.md",
      "line": 1,
      "byteOffset": 3,
      "preview": "needle here",
      "matchStart": 0,
      "matchEnd": 6
     }
    ],
    "scannedFiles": 1,
    "truncated": false
   }
  },
