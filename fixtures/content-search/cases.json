{
 "$comment": "C-16: content-search cases shared by the Rust search (commands/search.rs) and the memory shell (memory-search.test.ts). Paths are rewritten under a temporary directory by the Rust test. A file is {text} (UTF-8) or {hex}, optionally padded with 'x' to padTo bytes.",
 "cases": [
  {
   "name": "lf: line and offset",
   "files": {
    "/r/a.md": {
     "text": "alpha\nbeta needle gamma\n"
    }
   },
   "roots": [
    "/r"
   ],
   "paths": [
    "/r/a.md"
   ],
   "query": "needle",
   "opts": {},
   "expect": {
    "hits": [
     {
      "path": "/r/a.md",
      "line": 2,
      "byteOffset": 11,
      "preview": "beta needle gamma",
      "matchStart": 5,
      "matchEnd": 11
     }
    ],
    "scannedFiles": 1,
    "truncated": false
   }
  },
  {
   "name": "crlf: lines count line feeds, the preview drops the return",
   "files": {
    "/r/a.md": {
     "text": "one\r\ntwo\r\nthree needle\r\nfour"
    }
   },
   "roots": [
    "/r"
   ],
   "paths": [
    "/r/a.md"
   ],
   "query": "needle",
   "opts": {},
   "expect": {
    "hits": [
     {
      "path": "/r/a.md",
      "line": 3,
      "byteOffset": 16,
      "preview": "three needle",
      "matchStart": 6,
      "matchEnd": 12
     }
    ],
    "scannedFiles": 1,
    "truncated": false
   }
  },
  {
   "name": "bom: the offset counts the byte-order mark, the preview leaves it out",
