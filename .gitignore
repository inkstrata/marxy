node_modules/
dist/
demo-dist/
target/
out/
.venv/
*.log
# the corpus's log fixtures are test inputs, not output
!/fixtures/corpus/*.log
# and so is the demo's build log, which the demo build reads
!/fixtures/demo/**/*.log
.DS_Store
/results/
/apps/desktop/src-tauri/gen/schemas/
/apps/desktop/src-tauri/permissions/autogenerated/

# a global ignore of macOS "Icon\r" files (pattern `Icon?`) also matches this
# directory on case-insensitive filesystems; the app does not build without it
!/apps/desktop/src-tauri/icons/

# leftovers of the mutation oracle in sliced-oracle.test.ts
*.mutant-*.ts

# never commit credentials
*.env

# generated test-only certificates (fixtures/certs/make-certs.mjs); a global *.pem ignore would drop them
!/fixtures/certs/*.pem

# kept installers (pnpm work installer) and pictures taken by shots: working files, not records
/builds/
/work/shots/
